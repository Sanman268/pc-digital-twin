# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-token-here
INFLUXDB_ORG=home_lab
INFLUXDB_BUCKET=fm_simulation

# BLE
# Stock Silicon Labs demo firmware advertises as "Thunder Sense #NNNNN".
# Match by substring of the advertised name:
BLE_DEVICE_NAME=Thunder Sense
# Or skip name discovery entirely and connect directly by MAC (more reliable):
# BLE_DEVICE_ADDRESS=XX:XX:XX:XX:XX:XX
BLE_SCAN_TIMEOUT=10
BLE_RETRY_INTERVAL=5
BLE_SAMPLE_INTERVAL=2.0

# Asset
NODE_ID=TBS2_001
ASSET_ID=PC_CASE_001

# LLM
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
GEMMA_API_URL=http://localhost:11434/api/generate

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
